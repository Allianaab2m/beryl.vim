# beryl colorscheme. Generated by scripts/build.lua from lua/beryl/palette.lua; do not edit.
[delta "beryl"]
	dark = true
	syntax-theme = beryl
	minus-style = syntax "#36362A"
	minus-non-emph-style = syntax "#36362A"
	minus-emph-style = syntax "#5B412E"
	minus-empty-line-marker-style = syntax "#36362A"
	plus-style = syntax "#15493F"
	plus-non-emph-style = syntax "#15493F"
	plus-emph-style = syntax "#196757"
	plus-empty-line-marker-style = syntax "#15493F"
	line-numbers-minus-style = "#E07A50"
	line-numbers-plus-style = "#24C0A1"
	line-numbers-zero-style = "#7F9A93"
	line-numbers-left-style = "#2A433E"
	line-numbers-right-style = "#2A433E"
	file-style = "#E4F4EF"
	file-decoration-style = "#7F9A93" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#5FD9BC"
	hunk-header-line-number-style = "#7F9A93"
	hunk-header-decoration-style = "#2A433E" box ul
	commit-decoration-style = "#7F9A93" bold box ul
	blame-palette = "#112B26 #1E3732 #0D201C #2A433E"
