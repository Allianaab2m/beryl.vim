    "progressBar.background": "#24C0A1",
    "scrollbarSlider.background": "#2A433E99",
    "scrollbarSlider.hoverBackground": "#2A433E",
    "scrollbarSlider.activeBackground": "#107460",
    "list.activeSelectionBackground": "#0F6353",
    "list.activeSelectionForeground": "#E4F4EF",
    "list.inactiveSelectionBackground": "#1E3732",
    "list.hoverBackground": "#1E3732",
    "list.focusOutline": "#107460",
